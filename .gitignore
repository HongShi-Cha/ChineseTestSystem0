# ============================================================
# 国语水平测试系统 - 仓库根 .gitignore
# ============================================================

# ---------- 敏感配置（含讯飞 Key、数据库密码，绝不入库） ----------
.env
.env.local
.env.*.local
!.env.example
!.env.production.example

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------- 运行时数据 ----------
data/uploads/
data/backup/
data/temp/
logs/
*.log

# ---------- 编辑器 / IDE ----------
.idea/
.vscode/
*.iml
*.swp
*.swo

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 其他 ----------
*.bak
*.tmp