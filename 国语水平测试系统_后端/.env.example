# ============================================================
# 国语水平测试系统 - 后端环境变量模板
# 复制为 .env 后按需修改
# ============================================================

# ---------- 应用 ----------
APP_NAME=国语水平测试系统
APP_HOST=0.0.0.0
APP_PORT=8080
DEBUG=true

# ---------- MySQL ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=guoyu_test

# ---------- 会话 ----------
# 生产环境务必换成随机长字符串
SESSION_SECRET_KEY=change-me-to-a-random-secret
SESSION_MAX_AGE=86400

# ---------- 目录 ----------
# 前端静态文件目录（后端直接托管）；留空 = 自动取后端的上一级目录
FRONTEND_DIR=
# 录音上传目录；留空 = 后端目录/data/uploads
UPLOAD_DIR=

# ---------- 演示数据 ----------
# 首次启动是否生成演示成绩（表里已有数据时自动跳过）
SEED_DEMO_DATA=true

# ---------- 考试闭环保护（第 9 步） ----------
# 整场考试时长（秒）：组卷接口返回给前端的倒计时也取这里，保证前后端口径一致
EXAM_DURATION_SECONDS=780
# 交卷宽限期（秒）：倒计时结束后再给这么多秒，容忍正在路上的交卷请求
EXAM_DEADLINE_GRACE_SECONDS=30
# 单个学生允许完成的考试场次上限；0 = 不限次数
MAX_EXAM_ATTEMPTS=0
# 录音保留天数；0 = 永久保留。超期录音在服务启动时自动清理，也可由管理端手动触发
UPLOAD_RETENTION_DAYS=14
# 单次录音上传大小上限（字节），20971520 = 20MB
MAX_UPLOAD_BYTES=20971520

# ---------- 公网部署与安全加固（第 10 步） ----------
# 是否开放 /api/docs 在线接口文档；公网部署必须改 false
ENABLE_DOCS=true
# 允许跨域的来源（逗号分隔）；同源部署（nginx 同时托管前端与 /api）留空即可
CORS_ORIGINS=
# 会话 Cookie 是否只走 HTTPS；配好 nginx + 证书后必须改 true
SESSION_COOKIE_SECURE=false
# 是否追加安全响应头（nosniff / 防 iframe 嵌套 / Referrer-Policy）
SECURITY_HEADERS=true
# 登录失败锁定：同一账号在窗口内失败几次就锁
LOGIN_MAX_FAILURES=5
# 登录失败锁定：同一 IP 在窗口内失败几次就锁（校园网 NAT 共用一个出口，别设太小）
LOGIN_MAX_IP_FAILURES=100
# 登录失败统计窗口（秒），同时也是锁定时长
LOGIN_WINDOW_SECONDS=900
# 注册限流：同一 IP 每小时最多注册几个（防刷号）
REGISTER_MAX_PER_HOUR=5
# 讯飞评测并发上限（官方默认 50 路，留余量）与排队等待上限（秒）
ISE_MAX_CONCURRENCY=30
ISE_MAX_WAIT_SECONDS=20
# ---------- 评分 ----------
# mock=模拟评分（默认） | ise=讯飞语音评测
SCORING_MODE=mock
ISE_APP_ID=
ISE_API_KEY=
ISE_API_SECRET=
ISE_HOST=ise-api.xfyun.cn