# ============================================================
# 国语水平测试系统 - 生产环境配置模板（第 10 步）
#
# 用法：复制为 .env 放到后端根目录，按注释逐项修改。
# 这份模板的取值默认就是"公网安全"的，只有标注【必须改】的几项需要你填。
# 部署步骤见 deploy/DEPLOY.md。
# ============================================================

# ---------- 应用 ----------
APP_NAME=国语水平测试系统
# 【推荐】后台只需被 nginx 访问，绑 127.0.0.1 最安全，不要直接对外暴露 8080
APP_HOST=127.0.0.1
APP_PORT=8080
DEBUG=false

# ---------- MySQL ----------
# 【必须改】数据库密码，别再沿用 1234；用户名也建议单独建一个只授权 guoyu_test 的账号
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=guoyu
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DB_NAME=guoyu_test

# ---------- 会话 ----------
# 【必须改】生成方式：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET_KEY=CHANGE_ME_RANDOM_SECRET
# 会话有效期（秒）：3600 = 1 小时，够考完一场，泄漏窗口也更小
SESSION_MAX_AGE=3600

# ---------- 目录 ----------
FRONTEND_DIR=/srv/guoyu/frontend
UPLOAD_DIR=/srv/guoyu/backend/data/uploads

# ---------- 演示数据 ----------
# 【必须改】公网必须关掉，否则首启会写入演示账号（admin/admin123）和演示成绩
SEED_DEMO_DATA=false

# ---------- 评分 ----------
SCORING_MODE=ise
ISE_APP_ID=你的APPID
ISE_API_KEY=你的APIKey
ISE_API_SECRET=你的APISecret
ISE_HOST=ise-api.xfyun.cn
ISE_SEND_INTERVAL=0.01
ISE_MAX_RETRY=2
# 【推荐】正式环境不要回退模拟分：宁可报错让学生重录，也不要给出假成绩
ISE_FALLBACK_MOCK=false

# ---------- 考试闭环保护 ----------
EXAM_DURATION_SECONDS=780
EXAM_DEADLINE_GRACE_SECONDS=30
MAX_EXAM_ATTEMPTS=0
UPLOAD_RETENTION_DAYS=14
MAX_UPLOAD_BYTES=20971520

# ---------- 公网部署与安全加固 ----------
# 【必须改】关掉在线接口文档
ENABLE_DOCS=false
# 【必须改】填正式域名（同源部署其实用不到 CORS，留空即可；跨域才需要填）
CORS_ORIGINS=
# 【必须改】配好 nginx + HTTPS 证书后改成 true
SESSION_COOKIE_SECURE=true
SECURITY_HEADERS=true
LOGIN_MAX_FAILURES=5
# 校园网 NAT 常整栋楼共用一个出口 IP，IP 级阈值别设太小（0 = 关闭 IP 锁定）
LOGIN_MAX_IP_FAILURES=100
LOGIN_WINDOW_SECONDS=900
REGISTER_MAX_PER_HOUR=5
ISE_MAX_CONCURRENCY=30
ISE_MAX_WAIT_SECONDS=20